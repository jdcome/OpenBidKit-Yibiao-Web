# Copy the relevant values into server/.env and client/.env.
# Never commit real credentials.

DATABASE_URL=postgresql://yibiao:yibiao@127.0.0.1:5432/yibiao_web
JWT_SECRET=replace-with-at-least-32-random-characters
HOST=0.0.0.0
PORT=3000
YIBIAO_DATA_DIR=./data
VITE_API_BASE_URL=/api
VITE_SOURCE_REPOSITORY_URL=https://github.com/jdcome/OpenBidKit-Yibiao-Web
